# Server Configuration
PORT=3000
NODE_ENV=development

# Database path (defaults to ./data/simulation.db)
DB_PATH=./data/simulation.db

# Cryptographic Session Secret
SESSION_SECRET=change-this-to-a-cryptographically-secure-random-key-in-production

# Optional: Google Gemini API Key for autonomous agent decision intelligence
# Isolated strictly on the server; never exposed to browser frontend or network clients.
GEMINI_API_KEY=
